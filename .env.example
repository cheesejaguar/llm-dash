# Copy to .env for local reference only — server.js does not load .env files
# automatically (no dotenv dependency). Export these in your shell, or pass
# them inline, when running `node server.js` directly. See the "Configuration"
# section of README.md for full details on each variable.

# HTTP/SSE listen port.
PORT=9090

# Path to the dedicated ed25519 private key used to reach both cluster nodes.
# Required for node-stats collection; without it, nodes render as "down".
# See README.md "SSH agent key setup" before generating one.
SSH_KEY=/home/node/.ssh/id_ed25519_llmdash

# Remote user for the forced-command SSH session. Required — no default.
# Must match the account whose authorized_keys you restricted.
SSH_USER=<remote-ssh-user>

# Pinned host-key file passed to `ssh -o UserKnownHostsFile=`.
KNOWN_HOSTS=/app/deploy/known_hosts

# Base URL of the vLLM OpenAI-compatible server (scraped at /metrics, /v1/models).
# Set this to your head node's real address.
VLLM_BASE=http://<head-node-ip>:8000

# Reported max concurrent sequences (informational only).
VLLM_MAX_SEQS=12

# Override the built-in placeholder 2-node cluster. Must be a non-empty JSON
# array of {"host","ip","role"} objects. Always set this in production — the
# built-in default is a non-functional placeholder, not a real cluster.
# NODES_JSON=[{"host":"head","ip":"10.0.0.10","role":"head"},{"host":"worker","ip":"10.0.0.11","role":"worker"}]

# Recommended in production containers to keep the memory cap honest.
NODE_OPTIONS=--max-old-space-size=128
